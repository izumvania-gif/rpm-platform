# Copy to .env.test and point at a throwaway Postgres database — never the
# same one used by `npm run dev`. Integration tests truncate every table
# between runs (tests/integration/setup.ts).
#
#   createdb rpm_platform_test
#   cp .env.test.example .env.test   # then edit if your local Postgres differs
#   npm run db:push -- --schema prisma/schema.prisma  # against DATABASE_URL below, once
#   npm run test:integration

DATABASE_URL="postgresql://user:password@localhost:5432/rpm_platform_test?schema=public"
