// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products         Product[]
  researches       Research[]
  segments         Segment[]
  jtbds            JTBD[]
  hypotheses       Hypothesis[]
  conversations    Conversation[]
  competitors      Competitor[]
  productResources ProductResource[]
  features         Feature[]
  rtbs             RTB[]
}

// Продукты
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  stage       Stage    @default(IDEA)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  researches       Research[]
  segments         Segment[]
  jtbds            JTBD[]
  hypotheses       Hypothesis[]
  conversations    Conversation[]
  competitors      Competitor[]
  productResources ProductResource[]
  features         Feature[]
  rtbs             RTB[]
}

enum Stage {
  IDEA
  MVP
  GROWTH
  SCALE
}

// Исследования
model Research {
  id          String         @id @default(cuid())
  number      Int            @default(autoincrement())
  title       String
  description String?        @db.Text
  date        DateTime       @default(now())
  status      ResearchStatus @default(IN_PROGRESS)
  type        ResearchType
  tags        String[]
  pinned      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds         JTBD[]
  hypotheses    Hypothesis[]
  conversations Conversation[]
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
}

enum ResearchType {
  QUALITATIVE
  SURVEY
  ANALYTICS
  DESK_RESEARCH
  MANUAL
  QUANTITATIVE
  USABILITY_TESTING
}

// Сегменты
model Segment {
  id            String   @id @default(cuid())
  name          String
  slug          String
  audienceShare Float? // процент от 0 до 100
  color         String   @default("#3B82F6")
  description   String?  @db.Text
  tags          String[]
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds         JTBD[]
  hypotheses    Hypothesis[]
  conversations Conversation[]

  @@unique([productId, slug])
}

// JTBD (Jobs-to-be-Done)
model JTBD {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String?  @db.Text
  confirmed   Boolean  @default(false)
  tags        String[]
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hypotheses Hypothesis[]
  features   Feature[]
}

// Гипотезы
model Hypothesis {
  id        String           @id @default(cuid())
  statement String           @db.Text
  status    HypothesisStatus @default(DRAFT)
  priority  Int?
  tags      String[]
  pinned    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  jtbdId String?
  jtbd   JTBD?   @relation(fields: [jtbdId], references: [id], onDelete: SetNull)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  statusChanges HypothesisStatusChange[]
}

enum HypothesisStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  REJECTED
}

// История смены статуса гипотезы
model HypothesisStatusChange {
  id        String           @id @default(cuid())
  status    HypothesisStatus
  changedAt DateTime         @default(now())

  hypothesisId String
  hypothesis   Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
}

// Разговоры (CustDev)
model Conversation {
  id         String   @id @default(cuid())
  title      String
  transcript String?  @db.Text
  date       DateTime @default(now())
  tags       String[]
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Конкуренты
model Competitor {
  id          String   @id @default(cuid())
  name        String
  url         String?
  positioning String?  @db.Text
  features    String[] // краткий список фич конкурента
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Ресурсы продукта (sales-kit, dev-docs, ссылки на Confluence/Jira)
enum ProductResourceKind {
  SALES_KIT
  DEVELOPER_DOC
  CONFLUENCE_LINK
  JIRA_LINK
  OTHER
}

model ProductResource {
  id          String              @id @default(cuid())
  title       String
  kind        ProductResourceKind
  url         String?
  description String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Фичи — как продукт решает JTBD
model Feature {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds JTBD[]
  rtbs  RTB[]
}

// RTB (Reasons To Believe) — маркетинговые обещания, опирающиеся на фичи
model RTB {
  id        String   @id @default(cuid())
  statement String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  features Feature[]
}
