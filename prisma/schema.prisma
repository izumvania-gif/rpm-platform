// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products         Product[]
  researches       Research[]
  segments         Segment[]
  jtbds            JTBD[]
  hypotheses       Hypothesis[]
  conversations    Conversation[]
  competitors      Competitor[]
  productResources ProductResource[]
  features         Feature[]
  rtbs             RTB[]
  insights         Insight[]
  people           Person[]
  roadmapItems     RoadmapItem[]
  actionPlans      ActionPlan[]
  departments      Department[]
}

// Продукты
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  stage       Stage    @default(IDEA)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 2.0 (plans/platform-views-plan.md §1): ownerId is the responsible PM
  // (a Person, see below) — a separate axis from userId, which is the
  // tenant/creator in this still-single-tenant app, not "who manages this
  // product." publicSummary is the customer-facing one-liner for the open
  // company dashboard (§4 of the same plan); the public route falls back to
  // a trimmed `description` when it's empty.
  ownerId       String?
  owner         Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  publicSummary String? @db.Text

  // CPO strategic grouping (plans/platform-views-plan.md §11) — a separate
  // axis from userId/ownerId, same "cross-product organizational unit"
  // pattern as Person: a dedicated Department entity (not a free-text field
  // like RoadmapItem.trackGroup) so the CPO gets a rename-safe, typo-proof
  // list to group products/Gantt lanes by.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  researches       Research[]
  segments         Segment[]
  jtbds            JTBD[]
  hypotheses       Hypothesis[]
  conversations    Conversation[]
  competitors      Competitor[]
  productResources ProductResource[]
  features         Feature[]
  rtbs             RTB[]
  insights         Insight[]
  roadmapItems     RoadmapItem[]
  processes        Process[]
  actionPlans      ActionPlan[]
  teamMembers      ProductTeamMember[]
  canvasLayout     ProductCanvasLayout[]
}

// Ростер команды продукта (plans/2.0-ux-improvement-plan.md, Фаза 2) — lets a
// PM say "these people are on this product" before anyone has an assigned
// RoadmapItem/ProcessStep (the "chicken and egg" gap the UX audit found:
// without this, a person could only ever appear in /pm's Команда section
// derived from already having active work — lib/team-workload.ts's
// getProductTeam merges this roster with that derived list). No role/joined
// date field yet — same schema minimalism as the rest of the project, add
// only once a real need shows up.
model ProductTeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([productId, personId])
}

// CPO strategic departments (plans/platform-views-plan.md §11) — cross-product
// like Person, scoped to userId only rather than productId. A product picks
// at most one department; a department groups any number of products.
model Department {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#3B82F6")
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]
}

enum Stage {
  IDEA
  MVP
  GROWTH
  SCALE
}

// Исследования
model Research {
  id          String         @id @default(cuid())
  number      Int            @default(autoincrement())
  title       String
  description String?        @db.Text
  date        DateTime       @default(now())
  status      ResearchStatus @default(IN_PROGRESS)
  type        ResearchType
  tags        String[]
  pinned      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds         JTBD[]
  hypotheses    Hypothesis[]
  conversations Conversation[]
  insights      Insight[]
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
}

enum ResearchType {
  QUALITATIVE
  SURVEY
  ANALYTICS
  DESK_RESEARCH
  MANUAL
  QUANTITATIVE
  USABILITY_TESTING
}

// Сегменты
model Segment {
  id            String   @id @default(cuid())
  name          String
  slug          String
  audienceShare Float? // процент от 0 до 100
  color         String   @default("#3B82F6")
  description   String?  @db.Text
  tags          String[]
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds         JTBD[]
  hypotheses    Hypothesis[]
  conversations Conversation[]
  insights      Insight[]

  @@unique([productId, slug])
}

// Тип задачи по масштабу (методология JTBD):
// BIG_JOB — большая задача, которую продукт не решает полностью целиком (часто эмоциональная);
// CORE_JOB — самая крупная задача, которую продукт решает полностью;
// SMALL_JOB — задача до/после core job;
// MICRO_JOB — задача внутри small/core job.
enum JtbdJobType {
  BIG_JOB
  CORE_JOB
  SMALL_JOB
  MICRO_JOB
}

// JTBD (Jobs-to-be-Done)
model JTBD {
  id          String      @id @default(cuid())
  title       String
  category    String
  description String?     @db.Text
  jobType     JtbdJobType @default(SMALL_JOB)
  confirmed   Boolean     @default(false)
  tags        String[]
  pinned      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Many-to-many (was a single optional segmentId until §2.9 Фаза 2) — a JTBD can
  // apply to more than one customer segment; the JTBD graph then has one layout
  // per segment plus an "overall" layout, see JtbdGraphLayout below.
  segments Segment[]

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hypotheses   Hypothesis[]
  features     Feature[]
  insights     Insight[]
  roadmapItems RoadmapItem[]

  parentId String?
  parent   JTBD?   @relation("JtbdHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children JTBD[]  @relation("JtbdHierarchy")

  sequenceFrom JtbdSequenceEdge[] @relation("JtbdSequenceFrom")
  sequenceTo   JtbdSequenceEdge[] @relation("JtbdSequenceTo")

  graphLayouts JtbdGraphLayout[]
}

// Позиция узла JTBD на канвасе графа — по представлению ("overall" для общего
// графа продукта, или id сегмента для графа конкретного сегмента), а не одна
// на задачу: один и тот же JTBD может быть по-разному расставлен в разных
// представлениях. См. plans/growth-plan.md §2.9.1.
model JtbdGraphLayout {
  id        String   @id @default(cuid())
  jtbdId    String
  jtbd      JTBD     @relation(fields: [jtbdId], references: [id], onDelete: Cascade)
  viewKey   String
  x         Float
  y         Float
  updatedAt DateTime @updatedAt

  @@unique([jtbdId, viewKey])
}

// Тип узла на холсте продукта (plans/2.0-product-leap-plan.md, C2)
enum CanvasNodeKind {
  SEGMENT
  JTBD
  HYPOTHESIS
}

// Позиции узлов на холсте продукта. Отдельно от JtbdGraphLayout: тот хранит
// раскладку графа JTBD по представлениям (общее / по сегменту) и завязан на
// jtbdId, а здесь узлы трёх разных моделей на одном холсте продукта.
// Как и JtbdGraphLayout/JtbdSequenceEdge — без собственного userId, доступ
// ограничивается через productId -> Product -> userId.
model ProductCanvasLayout {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nodeKind  CanvasNodeKind
  nodeId    String
  x         Float
  y         Float
  updatedAt DateTime       @updatedAt

  @@unique([productId, nodeKind, nodeId])
}

// Рёбра последовательности JTBD ("задача A предшествует задаче B")
model JtbdSequenceEdge {
  id         String   @id @default(cuid())
  fromJtbdId String
  fromJtbd   JTBD     @relation("JtbdSequenceFrom", fields: [fromJtbdId], references: [id], onDelete: Cascade)
  toJtbdId   String
  toJtbd     JTBD     @relation("JtbdSequenceTo", fields: [toJtbdId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromJtbdId, toJtbdId])
}

// Гипотезы
model Hypothesis {
  id        String           @id @default(cuid())
  statement String           @db.Text
  status    HypothesisStatus @default(DRAFT)
  priority  Int?
  tags      String[]
  pinned    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // «При каком результате мы считаем гипотезу подтверждённой» — записывается
  // до проверки, а не после (фаза 2 редизайна 2.1). Без него статус
  // CONFIRMED — это мнение: критерий превращает его в проверяемый факт и
  // кормит чек-лист готовности на карточке гипотезы (фаза 3).
  //
  // Опционально и без значения по умолчанию намеренно: подставить сюда текст
  // за пользователя значило бы придумать критерий, которого никто не
  // формулировал. Пустое поле — честный ответ «критерия нет».
  validationCriterion String? @db.Text

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  jtbdId String?
  jtbd   JTBD?   @relation(fields: [jtbdId], references: [id], onDelete: SetNull)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  statusChanges HypothesisStatusChange[]

  // Доказательства (фаза 2 редизайна 2.1). До этого инсайт можно было
  // привязать к сегменту, JTBD, исследованию и разговору — то есть ко всему,
  // кроме утверждения, которое он подтверждает или опровергает.
  insights Insight[]

  // Фичи, которыми гипотеза отрабатывается. Многие-ко-многим, потому что
  // одна фича закрывает несколько гипотез, а одна гипотеза может требовать
  // нескольких фич — единственной FK тут не обойтись.
  features Feature[]
}

enum HypothesisStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  REJECTED
}

// История смены статуса гипотезы
model HypothesisStatusChange {
  id        String           @id @default(cuid())
  status    HypothesisStatus
  changedAt DateTime         @default(now())

  hypothesisId String
  hypothesis   Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
}

// Разговоры (CustDev)
model Conversation {
  id         String   @id @default(cuid())
  title      String
  transcript String?  @db.Text
  date       DateTime @default(now())
  tags       String[]
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  insights Insight[]
}

// Конкуренты
model Competitor {
  id            String    @id @default(cuid())
  name          String
  url           String?
  positioning   String?   @db.Text
  features      String[] // краткий список фич конкурента
  lastCheckedAt DateTime?
  pricingModel  String?
  companySize   String?
  pinned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsItems CompetitorNewsItem[]
}

model CompetitorNewsItem {
  id        String   @id @default(cuid())
  title     String
  url       String?
  date      DateTime @default(now())
  note      String?  @db.Text
  createdAt DateTime @default(now())

  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

// Ресурсы продукта (sales-kit, dev-docs, ссылки на Confluence/Jira)
enum ProductResourceKind {
  SALES_KIT
  DEVELOPER_DOC
  CONFLUENCE_LINK
  JIRA_LINK
  OTHER
}

model ProductResource {
  id          String              @id @default(cuid())
  title       String
  kind        ProductResourceKind
  url         String?
  description String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Фичи — как продукт решает JTBD
model Feature {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jtbds        JTBD[]
  rtbs         RTB[]
  roadmapItems RoadmapItem[]
  hypotheses   Hypothesis[]
}

// RTB (Reasons To Believe) — маркетинговые обещания, опирающиеся на фичи
model RTB {
  id        String   @id @default(cuid())
  statement String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  features Feature[]
}

// Атомарные инсайты — цитата или вывод из исследования/разговора, с привязкой
// к сегменту/JTBD (вместо того чтобы держать всё внутри одного транскрипта Conversation)
model Insight {
  id        String   @id @default(cuid())
  text      String   @db.Text
  tags      String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  jtbdId String?
  jtbd   JTBD?   @relation(fields: [jtbdId], references: [id], onDelete: SetNull)

  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Гипотеза, которую этот инсайт подтверждает или опровергает (фаза 2
  // редизайна 2.1). SetNull, как и остальные связи инсайта: удаление
  // гипотезы не должно уносить с собой цитату из разговора — сказанное
  // клиентом остаётся фактом независимо от судьбы утверждения.
  hypothesisId String?
  hypothesis   Hypothesis? @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)

  // За или против. Nullable намеренно, и это не «ещё не заполнили»: инсайт
  // может быть просто наблюдением, не занимающим сторону, и заставлять его
  // выбирать значило бы получать выдуманные голоса в полосе баланса.
  stance InsightStance?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InsightStance {
  SUPPORTS
  CONTRADICTS
}

// --- 2.0 (plans/platform-views-plan.md) ---

// Лёгкая карточка человека для командного дашборда/делегирования (§1, §0.2
// of the plan) — deliberately NOT a login account, same kind of record
// Competitor already is: exists to be referenced and displayed, not to
// authenticate. Not scoped to a single Product (unlike every 1.0 content
// model) — a person can be relevant across several products at once, e.g.
// a PM who owns 3 products or a marketing lead who works across all of them.
model Person {
  id        String   @id @default(cuid())
  name      String
  role      String? // free-text title, e.g. "Маркетинг-лид"
  team      String? // free-text grouping, e.g. "Продукт", "Маркетинг"
  email     String? // display only, not a login
  avatarUrl String?
  skills    String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedProducts   Product[]
  roadmapItems    RoadmapItem[]
  processSteps    ProcessStep[]
  actionPlans     ActionPlan[]
  teamMemberships ProductTeamMember[]
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  SHIPPED
  PAUSED
}

enum RoadmapVisibility {
  INTERNAL
  PUBLIC
}

// Пункт роадмапа продукта (plans/platform-views-plan.md §1) — не всегда уже
// существующая Feature (может быть ставка/эксперимент/этап исследования),
// поэтому featureId и jtbdId опциональны, а не обязательная связь.
model RoadmapItem {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  status      RoadmapStatus     @default(PLANNED)
  quarter     String? // свободный текст "2026 Q3" — не date-range picker,
  // пока реальное использование не покажет, что нужен более строгий формат
  visibility  RoadmapVisibility @default(INTERNAL)
  pinned      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Gantt view (/pm's "Гант" tab, added after the platform-views-plan's 8
  // phases shipped) — trackGroup/track are free-text lanes, same philosophy
  // as `quarter` above: the PM defines what a "parallel process" means for
  // their product rather than picking from a fixed taxonomy. trackGroup
  // nests track under a block (e.g. "Разработка" containing "Фронт"/"Бэк"),
  // both optional so existing items without them still work — they fall
  // back to "Без блока"/"Без трека" groups on the chart.
  trackGroup  String?
  track       String?
  startDate   DateTime?
  endDate     DateTime?
  // A milestone renders as a full-height vertical line labeled with the
  // item's title (e.g. "v2.5") instead of a bar — startDate is the
  // marker's date, endDate/track/trackGroup are ignored for milestones.
  isMilestone Boolean   @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  jtbdId String?
  jtbd   JTBD?   @relation(fields: [jtbdId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A product can describe more than one process (plans/platform-views-plan.md
// §1, §3, extended in §11) — e.g. "Запуск фичи" and "Обработка инцидента" are
// separate flows with separate step/edge graphs, not one shared canvas.
// /pm shows a list of a product's processes first, then a single process's
// canvas on click — mirrors how the JTBD graph is scoped per view, just one
// level up (per process instead of per segment). Unlike the JTBD graph
// though, a process has no further per-view layout: position lives directly
// on ProcessStep.x/y with no JtbdGraphLayout equivalent. No userId on either
// model — same convention as JtbdGraphLayout/JtbdSequenceEdge, scoped
// through the productId → Product → userId chain instead.
model Process {
  id        String   @id @default(cuid())
  title     String // напр. "Запуск маркетинговой кампании", "Обработка инцидента"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  steps ProcessStep[]
}

model ProcessStep {
  id        String   @id @default(cuid())
  title     String // напр. "PM планирует кампанию", "Обсуждение с маркетингом"
  x         Float
  y         Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  assignedPersonId String?
  assignedPerson   Person? @relation(fields: [assignedPersonId], references: [id], onDelete: SetNull)

  edgesFrom   ProcessEdge[] @relation("ProcessFrom")
  edgesTo     ProcessEdge[] @relation("ProcessTo")
  actionPlans ActionPlan[]
}

model ProcessEdge {
  id         String      @id @default(cuid())
  fromStepId String
  fromStep   ProcessStep @relation("ProcessFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStepId   String
  toStep     ProcessStep @relation("ProcessTo", fields: [toStepId], references: [id], onDelete: Cascade)
  label      String? // напр. "передаёт в", "согласовывает с"
  createdAt  DateTime    @default(now())

  @@unique([fromStepId, toStepId])
}

// Быстрые экшн-планы на предсказуемые "пожары" (§3) — обоснование в
// plans/pm-time-allocation-research.md §1: 52% времени PM уходит на
// незапланированное реагирование (ProductPlan, State of Product Management).
// Не система инцидент-менеджмента — просто заранее написанный "что делать",
// чтобы в моменте не тратить время на придумывание реакции с нуля.
model ActionPlan {
  id        String   @id @default(cuid())
  scenario  String // "Клиент публично жалуется в соцсетях", "Конкурент резко снизил цену"
  trigger   String?  @db.Text // как понять, что сценарий наступил
  steps     String[] // упорядоченный список коротких шагов — Postgres-массив
  // сохраняет порядок вставки, тот же паттерн, что и Competitor.features,
  // но по одному шагу на строку (toLines), а не через запятую
  tags      String[] // свободные категории ("PR-кризис", "срыв дедлайна") —
  // тот же паттерн тегов, что у остальных моделей (toTagsArray)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ownerId String? // кто координирует реакцию по этому сценарию
  owner   Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  processStepId String? // опционально — к какому шагу процесса относится
  processStep   ProcessStep? @relation(fields: [processStepId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
